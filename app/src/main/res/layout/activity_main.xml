<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0F172A"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <!-- App Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="📥 YOUTUBE PRO DOWNLOADER"
        android:textColor="#38BDF8"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginTop="30dp"
        android:layout_marginBottom="40dp"/>

    <!-- URL Input Card -->
    <EditText
        android:id="@+id/etUrl"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:background="#1E293B"
        android:hint="Paste YouTube Video URL here..."
        android:textColorHint="#64748B"
        android:textColor="#FFFFFF"
        android:paddingHorizontal="16dp"
        android:textSize="14sp"
        android:inputType="textUri"
        android:layout_marginBottom="20dp"/>

    <!-- Download Button -->
    <Button
        android:id="@+id/btnDownload"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:text="START DOWNLOAD 🚀"
        android:textSize="16sp"
        android:textStyle="bold"
        android:backgroundTint="#2563EB"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="20dp"/>

    <!-- Status Label -->
    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Status: Ready"
        android:textColor="#22C55E"
        android:textSize="14sp"
        android:layout_marginBottom="50dp"/>

    <!-- Strict Branding Footer -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Created by Chishti Bro Computer &amp; Developers\nFounder: Moinuddin Chishti"
        android:textColor="#94A3B8"
        android:textSize="12sp"
        android:gravity="center"
        android:textStyle="italic"
        android:layout_gravity="bottom"/>

</LinearLayout>
      
